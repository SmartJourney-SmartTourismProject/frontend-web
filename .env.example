# SmartJourney Frontend Environment Variables

# Backend API URL (required)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional: Sentry
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# Optional: Map provider (if using maps)
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxx