# Copy to .env.local and fill in. .env.local is gitignored.

# ===== Backends =====
# NestJS API (backend/). No path prefix - controllers are mounted at the root.
NEXT_PUBLIC_API_URL=http://localhost:3000
# FastAPI AI backend (ai-backend/), still called directly for plan-trip.
NEXT_PUBLIC_AI_BACKEND_URL=http://localhost:8000

# ===== Auth (Keycloak via next-auth) =====
# Must match the port you run `next dev` on (package.json uses 3001).
NEXTAUTH_URL=http://localhost:3001
# openssl rand -base64 32
NEXTAUTH_SECRET=
KEYCLOAK_ISSUER=http://localhost:8081/realms/smartjourney
KEYCLOAK_CLIENT_ID=smartjourney-web
# Realm smartjourney -> Clients -> smartjourney-web -> Credentials.
# Same value as KEYCLOAK_WEB_CLIENT_SECRET in backend/.env.
KEYCLOAK_CLIENT_SECRET=
# Public copy of the issuer, for links to Keycloak's account console.
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8081/realms/smartjourney
