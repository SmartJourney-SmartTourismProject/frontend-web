# Copy to .env.local and fill in. .env.local is gitignored.

# NestJS API (backend/), which runs on 3001 in local dev (this app takes 3000).
# The frontend never calls the AI backend directly - only NestJS does.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ===== Auth (Keycloak via next-auth) =====
# Must match the port `next dev` runs on.
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=
KEYCLOAK_ISSUER=http://localhost:8081/realms/smartjourney
KEYCLOAK_CLIENT_ID=smartjourney-web
# Realm smartjourney -> Clients -> smartjourney-web -> Credentials.
# Same value as KEYCLOAK_WEB_CLIENT_SECRET in backend/.env.
KEYCLOAK_CLIENT_SECRET=
# Public copy of the issuer, for links to Keycloak's account console.
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8081/realms/smartjourney
# Public copy of the client id, for the "forgot password" link.
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=smartjourney-web

# ===== Optional =====
# Public URL of this site, for absolute Open Graph/social-preview links.
# Production: https://aismartjourney.vercel.app (default http://localhost:3000).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Playwright e2e (npm run test:e2e). The suite creates this traveler in the
# local Keycloak through the admin API; the defaults below are used if unset.
# E2E_USERNAME=e2e-traveler
# E2E_EMAIL=e2e-traveler@smartjourney.test
# E2E_PASSWORD=E2e!pass99
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
